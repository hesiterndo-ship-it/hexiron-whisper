BOT_TOKEN=
OWNER_ID=

# آدرس بک‌اند فروشگاه HEXIRON SALES شما (همان ریپازیتوری hexiron-sales)
# مثال: SALES_API_URL=https://sales.yourdomain.com
# این بات با GET {SALES_API_URL}/api/v1/license?product=PRODUCT_CODE&group_id=<chat_id>
# و هدر X-API-Key تماس می‌گیرد و انتظار پاسخ JSON شامل {"active": true/false, "plan": "free|pro|business"} دارد.
# اگر endpoint شما مسیر/فرمت دیگری دارد، services/licensing.py را با همان قرارداد هماهنگ کن.
SALES_API_URL=
SALES_API_KEY=

DB_PATH=/data/hexiron_whisper.db
WHISPER_DEFAULT_TTL=3600
SESSION_MAX_SECONDS=7200
FREE_DAILY_WHISPERS=50
FREE_GROUP_LIMIT=1
RETENTION_DAYS=30

# باید دقیقاً با slug همین محصول در فروشگاه (sales/hexiron-whisper.product.json) یکی باشد
PRODUCT_CODE=whisper

# مدت کش نتیجه‌ی لایسنس و مهلت fail-open در صورت قطعی فروشگاه
LICENSE_CACHE_TTL=300
LICENSE_GRACE_SECONDS=21600

APP_URL=
